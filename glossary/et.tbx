    <text>
        <body>
            <termEntry id="Unidad de almacenamiento de Openshelf">
                <langSet xml:lang="es"><tig><term>Estantería</term></tig></langSet>
                <langSet xml:lang="et"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="Un tipo de tag que marca las categorias específicas del libro">
                <langSet xml:lang="es"><tig><term>Categorías</term></tig></langSet>
                <langSet xml:lang="et"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="Un tipo de tag que contiene una serie de libros ordenados pro número de colección">
                <langSet xml:lang="es"><tig><term>Colecciones</term></tig></langSet>
                <langSet xml:lang="et"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="Sello editorial específico dentro de una editorial">
                <langSet xml:lang="es"><tig><term>Sello editrorial</term></tig></langSet>
                <langSet xml:lang="et"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="Placeholder para integers">
                <langSet xml:lang="es"><tig><term>{count}</term></tig></langSet>
                <langSet xml:lang="et"><tig><term></term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
